# Copia este archivo a ".env" y completa los valores reales.
# NUNCA commitees el archivo ".env" real (ver .gitignore).

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Base de datos (MongoDB Atlas) ---
# Ejemplo de connection string de Atlas -- reemplaza usuario/password/cluster/db.
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/user_crud_express?retryWrites=true&w=majority

# --- JWT ---
# Genera un secreto largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1d

# --- Bloqueo de cuenta por intentos fallidos ---
MAX_LOGIN_ATTEMPTS=3
LOCK_TIME_MINUTES=15

# --- Hashing de contraseñas ---
BCRYPT_SALT_ROUNDS=10

# --- CORS ---
# Origen permitido para el frontend. Usa "*" solo en desarrollo.
CORS_ORIGIN=*
